# API fuera de Docker (pnpm start:dev) conectada a los servicios de Docker:
#   docker compose up -d db redis mailpit
# Copia este archivo a ".env" (apps/api/.env). Esta en .gitignore; este .env.example SI se versiona.
# Si corres TODO con `docker compose up`, no necesitas este archivo.

PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Base de datos (Postgres de Docker, puerto del host 5433) ---
DATABASE_URL=postgresql://alquiler:alquiler@localhost:5433/alquiler
DIRECT_URL=postgresql://alquiler:alquiler@localhost:5433/alquiler
REDIS_URL=redis://localhost:6379

# --- Autenticacion (valores de desarrollo; cambialos en produccion) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Minimo 32 caracteres. Si lo cambias se pierden los datos cifrados (2FA, correos).
ENCRYPTION_KEY=dev-encryption-key-change-me-0123456789abcdef

# --- Seguridad (ver docs/FRONTEND-SEGURIDAD.md) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
THREAT_MODE=monitor
RISK_MODE=monitor
SECOND_FACTOR_MODE=monitor
# "No soy un robot" (Cloudflare Turnstile). Un solo interruptor para API y web; con true hacen falta las dos claves.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Prefijo de las rutas de administracion (/api/<prefijo>/...). En produccion usa un nombre propio y poco obvio (min. 8 caracteres)
ADMIN_API_PREFIX=admin
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
APP_CLIENT_KEY_WEB=dev-web-client-key
APP_CLIENT_KEY_MOBILE=dev-mobile-client-key

# --- Correo: Mailpit de Docker (bandeja en http://localhost:8026) ---
MAIL_FROM=no-reply@localhost
MAIL_HOST=localhost
MAIL_PORT=1025

# --- Imagenes ---
STORAGE_PROVIDER=local
