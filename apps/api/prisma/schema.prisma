// Esquema de base de datos: tablas, relaciones y enums (Prisma genera las migraciones y el cliente).
// Los enums se mantienen iguales a packages/shared/src/enums.
// PostGIS: se activa despues (ver README, "simple primero"); por ahora lat/lng normales.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum Role {
  CLIENT
  OWNER
  AGENCY
  ADMIN
}

enum AgencyMemberRole {
  AGENCY_ADMIN
  AGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_EMAIL
  LINK_SOCIAL_ACCOUNT
}

enum BlockType {
  IP
  CIDR
  COUNTRY
  USER
  EMAIL
  EMAIL_DOMAIN
}

enum PropertyStatus {
  PUBLICADA
  RESERVADA
  ALQUILADA
  PAUSADA
}

enum PropertyType {
  APARTAMENTO
  CASA
  TOWNHOUSE
  HABITACION
  LOCAL
  OFICINA
  GALPON
  TERRENO
}

enum Currency {
  USD
  VES
}

enum AppointmentType {
  VISITA
  RESERVA
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
  COMPLETADA
}

enum ContactChannel {
  EMAIL
  WHATSAPP
  TELEFONO
}

enum ImportStatus {
  PROCESANDO
  COMPLETADA
  FALLIDA
}

// ---------------------------------------------------------------
// Usuarios y autenticacion
// ---------------------------------------------------------------

model User {
  id                String     @id @default(uuid())
  /// cifrado (security/encryption); se busca por emailHash
  email             String
  /// HMAC del correo normalizado: login y unicidad sin guardar el correo en claro
  emailHash         String     @unique
  /// HMAC de prefijos de nombre y correo: buscador del admin sin texto en claro
  searchTokens      String[]   @default([])
  /// null cuando la cuenta se creo solo con Google
  passwordHash      String?
  /// cifrado
  name              String
  /// cifrado
  phone             String?
  avatarUrl         String?
  roles             Role[]     @default([CLIENT])
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  twoFactorEnabled  Boolean    @default(false)
  /// secreto TOTP cifrado (nunca en claro)
  twoFactorSecret   String?
  /// ultimo paso TOTP aceptado: impide reutilizar el mismo codigo (anti-replay)
  twoFactorLastStep Int?
  /// desde cuando debe tener passkey o 2FA (admin, duenos y agencias); null = aun no empezo el plazo (security/second-factor)
  secondFactorRequiredFrom DateTime?
  failedLogins      Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  socialAccounts     SocialAccount[]
  sessions           Session[]
  verifications      VerificationCode[]
  backupCodes        TwoFactorBackupCode[]
  agencyMembers      AgencyMember[]
  ownedProperties    Property[]            @relation("PropertyOwner")
  assignedProperties Property[]            @relation("PropertyAgent")
  favorites          Favorite[]
  appointments       Appointment[]         @relation("AppointmentClient")
  auditLogs          AuditLog[]
  imports            ImportJob[]
  trustedDevices     TrustedDevice[]
  loginFootprints    LoginFootprint[]
  passkeys           PasskeyCredential[]

  @@index([status])
  @@index([searchTokens], type: Gin)
}

model SocialAccount {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  /// HMAC del id del proveedor (no el id en claro)
  providerId String
  /// cifrado
  email      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

/// Sesion = refresh token rotativo (se guarda el hash, nunca el token)
model Session {
  id                String    @id @default(uuid())
  userId            String
  refreshTokenHash  String    @unique
  /// cifrado
  userAgent         String?
  /// cifrado
  ip                String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  /// true si en esta sesion se completo el 2FA (el refresh lo conserva)
  twoFactorVerified Boolean   @default(false)
  /// ultima vez que esta sesion paso un factor fuerte (codigo 2FA o passkey); las acciones sensibles piden que sea reciente. El refresh lo conserva
  strongAuthAt      DateTime?
  /// dispositivo desde el que se abrio la sesion (security/access-risk); null en sesiones anteriores
  deviceId          String?
  /// pais de confianza (2 letras) al abrir o renovar la sesion; null si no se sabia
  country           String?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([deviceId])
}

/// Dispositivo desde el que el usuario inicia sesion (security/access-risk). El cliente guarda un secreto
/// aleatorio (cookie device_token / app movil); aqui solo se guarda su hash.
model TrustedDevice {
  id          String    @id @default(uuid())
  userId      String
  /// SHA-256 del secreto del dispositivo
  secretHash  String    @unique
  /// "Chrome en Windows": solo familia de navegador y sistema, sin datos personales
  label       String
  /// null = visto solo con la clave; fecha = verificado con segundo factor (o primer inicio de sesion de la cuenta)
  confirmedAt DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// pais (2 letras) del ultimo inicio de sesion desde aqui
  lastCountry String?
  /// vence a los 30 dias sin uso (se renueva en cada inicio de sesion)
  expiresAt   DateTime
  revokedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@index([expiresAt])
}

enum FootprintKind {
  COUNTRY
  NETWORK
}

/// Donde suele entrar un usuario (security/access-risk). Solo se anota tras un inicio de sesion completo.
model LoginFootprint {
  id          String        @id @default(uuid())
  userId      String
  kind        FootprintKind
  /// COUNTRY: codigo de 2 letras. NETWORK: HMAC de la red /24 (IPv4) o /48 (IPv6); nunca la IP
  value       String
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  seenCount   Int           @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, value])
  @@index([userId, kind, lastSeenAt])
}

/// Passkey (huella, Face ID, Windows Hello...) de un usuario (security/passkeys). Solo se guarda la clave PUBLICA:
/// la privada nunca sale del dispositivo, y la huella o la cara nunca llegan al servidor.
model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  /// id que entrega el autenticador (base64url)
  credentialId String    @unique
  /// clave publica en formato COSE (base64url); no es secreta
  publicKey    String
  /// algoritmo COSE: -7 ES256, -257 RS256, -8 EdDSA
  algorithm    Int
  /// contador del autenticador (uint32, por eso BigInt); si baja, la passkey se clono
  signCount    BigInt    @default(0)
  transports   String[]  @default([])
  /// nombre que le pone el usuario ("Mi iPhone")
  label        String
  /// true si se sincroniza entre dispositivos (iCloud, Google); bandera BE del autenticador
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PasskeyChallengeKind {
  REGISTER
  LOGIN
  STEP_UP
}

/// Desafio de un solo uso para registrar o usar una passkey. Se guarda su hash, nunca el valor.
model PasskeyChallenge {
  id            String               @id @default(uuid())
  challengeHash String               @unique
  kind          PasskeyChallengeKind
  /// REGISTER y STEP_UP van atados a un usuario; LOGIN no (la passkey dice quien es)
  userId        String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime             @default(now())

  @@index([expiresAt])
}

/// Codigos de 6 digitos (correo, reset, 2FA por email) - se guarda el hash
model VerificationCode {
  id        String           @id @default(uuid())
  userId    String
  type      VerificationType
  codeHash  String
  /// datos extra, ej. el HMAC del providerId de Google que se va a vincular
  payload   Json?
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------
// Agencias (organizacion con subcuentas)
// ---------------------------------------------------------------

model AgencyProfile {
  id            String   @id @default(uuid())
  name          String
  /// cifrado
  legalName     String?
  /// cifrado; se busca y es unico por rifHash
  rif           String?
  /// HMAC del RIF normalizado
  rifHash       String?  @unique
  description   String?
  logoUrl       String?
  bannerUrl     String?
  /// cifrado
  phone         String?
  /// cifrado
  whatsapp      String?
  website       String?
  maxProperties Int      @default(100)
  maxAgents     Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members    AgencyMember[]
  properties Property[]
  imports    ImportJob[]
}

model AgencyMember {
  id                  String           @id @default(uuid())
  agencyId            String
  /// null mientras la invitacion sigue pendiente
  userId              String?
  /// cifrado; se busca por invitedEmailHash
  invitedEmail        String
  invitedEmailHash    String
  role                AgencyMemberRole @default(AGENT)
  invitationStatus    InvitationStatus @default(PENDING)
  invitationTokenHash String?          @unique
  invitationExpiresAt DateTime?
  createdAt           DateTime         @default(now())

  agency AgencyProfile @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, invitedEmailHash])
  @@index([userId])
}

// ---------------------------------------------------------------
// Propiedades
// ---------------------------------------------------------------

model Property {
  id          String         @id @default(uuid())
  title       String
  description String
  type        PropertyType
  status      PropertyStatus @default(PUBLICADA)

  priceAmount Decimal  @db.Decimal(12, 2)
  currency    Currency @default(USD)

  bedrooms     Int      @default(0)
  bathrooms    Int      @default(0)
  parkingSpots Int      @default(0)
  areaM2       Decimal? @db.Decimal(10, 2)
  furnished    Boolean  @default(false)
  petsAllowed  Boolean  @default(false)

  // Ubicacion
  state        String
  municipality String
  urbanization String?
  address      String?
  latitude     Float
  longitude    Float

  // Amenities locales
  hasGenerator  Boolean @default(false) // planta electrica
  hasWaterTank  Boolean @default(false) // tanque / hidroneumatico
  hasFiberOptic Boolean @default(false)
  hasSecurity   Boolean @default(false) // vigilancia

  ownerUserId     String
  agencyId        String?
  assignedAgentId String?

  /// fila de importacion que la creo (trazabilidad)
  importJobId String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner         User            @relation("PropertyOwner", fields: [ownerUserId], references: [id])
  agency        AgencyProfile?  @relation(fields: [agencyId], references: [id])
  assignedAgent User?           @relation("PropertyAgent", fields: [assignedAgentId], references: [id])
  importJob     ImportJob?      @relation(fields: [importJobId], references: [id])
  images        PropertyImage[]
  appointments  Appointment[]
  favorites     Favorite[]

  @@index([status, state, municipality])
  @@index([latitude, longitude])
  @@index([priceAmount])
  @@index([ownerUserId])
  @@index([agencyId])
  @@index([assignedAgentId])
}

model PropertyImage {
  id          String   @id @default(uuid())
  propertyId  String
  /// rutas dentro del bucket (no URLs completas): properties/{propertyId}/thumb/{uuid}.webp
  originalKey String
  thumbKey    String
  mediumKey   String
  hdKey       String
  position    Int      @default(0)
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
}

model Favorite {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

// ---------------------------------------------------------------
// Citas / leads
// ---------------------------------------------------------------

model Appointment {
  id               String            @id @default(uuid())
  propertyId       String
  clientId         String
  type             AppointmentType   @default(VISITA)
  status           AppointmentStatus @default(PENDIENTE)
  /// fecha propuesta para la visita (null en una reserva directa)
  scheduledAt      DateTime?
  /// cifrado
  message          String?
  /// cifrado
  contactName      String
  /// cifrado
  contactPhone     String?
  preferredChannel ContactChannel    @default(WHATSAPP)
  /// cifrado
  responseNote     String?
  respondedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  client   User     @relation("AppointmentClient", fields: [clientId], references: [id])

  @@index([propertyId, status])
  @@index([clientId])
}

// ---------------------------------------------------------------
// Importacion masiva
// ---------------------------------------------------------------

model ImportJob {
  id           String       @id @default(uuid())
  userId       String
  agencyId     String?
  status       ImportStatus @default(PROCESANDO)
  fileKey      String
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  failedRows   Int          @default(0)
  /// [{ row: 3, errors: ["precio invalido"] }]
  errors       Json?
  createdAt    DateTime     @default(now())
  finishedAt   DateTime?

  user       User           @relation(fields: [userId], references: [id])
  agency     AgencyProfile? @relation(fields: [agencyId], references: [id])
  properties Property[]

  @@index([userId])
  @@index([agencyId])
}

// ---------------------------------------------------------------
// Seguridad y auditoria
// ---------------------------------------------------------------

model BlockRule {
  id        String    @id @default(uuid())
  type      BlockType
  /// IP, CIDR, codigo de pais (VE), userId, email o dominio segun el tipo
  value     String
  reason    String?
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([type, value])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  /// cifrado
  ip         String?
  /// cifrado
  userAgent  String?
  /// estado antes/despues y metadatos (NUNCA contrasenas, tokens ni codigos); cifrado como { enc: "v1..." }
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
}

/// Ajustes de la plataforma que el admin puede cambiar sin tocar variables de entorno (modulo settings).
/// Solo existen las claves del registro del codigo; los secretos (ej. la API key de Resend) se guardan cifrados.
model PlatformSetting {
  key       String   @id
  /// texto en claro, o cifrado ("v1....") si `secret` es true
  value     String
  secret    Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}
