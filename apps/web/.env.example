# Web fuera de Docker (pnpm dev) hablando con el API en localhost:3001.
# Copia este archivo a ".env" (apps/web/.env). Esta en .gitignore; este .env.example SI se versiona.
# Next solo expone al navegador las variables NEXT_PUBLIC_*.

NEXT_PUBLIC_APP_NAME=Portal de Alquileres
# URL del API vista desde el NAVEGADOR (el cliente agrega /api).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Debe ser igual a APP_CLIENT_KEY_WEB del API. No es un secreto (viaja en el navegador).
NEXT_PUBLIC_APP_CLIENT_KEY=dev-web-client-key
# false = solo datos reales del API (lo normal con la base sembrada); auto = ejemplo si el API no responde.
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_SHOW_THEME_PICKER=true
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_DETAIL_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
