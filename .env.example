# ============================================================
# NO necesitas este archivo para desarrollo local:  docker compose up
# ya trae valores por defecto que funcionan.
# Copialo a ".env" SOLO si quieres cambiar algo (ej. usar Supabase).
# ============================================================

# --- General ---------------------------------------------------
# Nombre de la plataforma (pendiente de definir, es provisional)
APP_NAME=Portal de Alquileres
NEXT_PUBLIC_APP_NAME=Portal de Alquileres
# Boton flotante para probar color de marca y modo noche (herramienta de diseno). false para ocultarlo.
NEXT_PUBLIC_SHOW_THEME_PICKER=true
# WhatsApp de contacto de ejemplo (solo digitos con codigo de pais, ej: 584120000000). Vacio = WhatsApp abre sin numero.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Datos del mapa: auto = usa el API y, si no responde, datos de ejemplo; true = siempre ejemplo; false = solo API.
NEXT_PUBLIC_USE_MOCKS=auto
# Estilos de mapa (OpenFreeMap, gratis y sin clave). Cambiar a otro proveedor = cambiar estas URLs.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_DETAIL_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
FRONTEND_URL=http://localhost:3000

# --- Puertos del host (cambialos si alguno esta ocupado) -----------
# WEB_PORT=3000
# API_PORT=3001
# DB_PORT=5433
# REDIS_PORT=6379
# MAILPIT_UI_PORT=8026

# --- Base de datos ----------------------------------------------
# Por defecto Docker usa su propio Postgres (con PostGIS).
# Para usar Supabase, descomenta y pega tus URLs:
#   DATABASE_URL = pooler (puerto 6543, ?pgbouncer=true)
#   DIRECT_URL   = conexion directa (puerto 5432), solo para migraciones
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Autenticacion (minimo 16 caracteres; cambialos en produccion) ----
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# Cifra el secreto del 2FA en la base (minimo 32 caracteres; si lo cambias se pierden los 2FA activos)
# ENCRYPTION_KEY=
# Cifrado de datos personales en la DB, con claves versionadas: v1:clave,v2:clave (cada una minimo 32 caracteres).
# Vacio = v1 es ENCRYPTION_KEY. Para rotar agrega v2 (lo viejo sigue leyendose). Respaldala aparte de la DB.
# ENCRYPTION_KEYS=
# ENCRYPTION_ACTIVE_VERSION=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seguridad: quien puede llamar al API -------------------------
# Origenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Modelo de amenazas: off | monitor (solo registra) | enforce (bloquea por tiempo). En produccion usa enforce.
THREAT_MODE=monitor
# Riesgo de login (pais/dispositivo nuevos): off | monitor (mide y avisa) | enforce (exige 2FA o niega). En produccion usa enforce.
RISK_MODE=monitor
# Segundo factor (passkey o 2FA) obligatorio para admin, duenos y agencias: off | monitor (avisa) | enforce (bloquea hasta activarlo). En produccion usa enforce.
SECOND_FACTOR_MODE=monitor
# Prefijo de las rutas de administracion (/api/<prefijo>/...). En produccion usa un nombre propio y poco obvio (min. 8 caracteres)
ADMIN_API_PREFIX=admin
# Lo mismo que ADMIN_API_PREFIX, para la WEB (la pantalla de ajustes del admin lo necesita). Es visible en el navegador.
NEXT_PUBLIC_ADMIN_API_PREFIX=admin
# Passkeys (huella / Face ID): el dominio del sitio y los origenes exactos de la web. En produccion: tu dominio real.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
# "No soy un robot" (Cloudflare Turnstile) en registro, login, recuperar clave y reenvio de codigos.
# UN SOLO INTERRUPTOR: la web le pregunta a la API si esta activo y con que clave publica (GET /api/auth/human-check).
# Con true hacen falta las dos claves (crealas en Cloudflare: Turnstile > Add widget). La secreta solo vive en la API.
# TURNSTILE_ENABLED=false
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Claves de cliente por app (cabecera X-App-Client). Cambialas en produccion.
APP_CLIENT_KEY_WEB=dev-web-client-key
APP_CLIENT_KEY_MOBILE=dev-mobile-client-key
NEXT_PUBLIC_APP_CLIENT_KEY=dev-web-client-key

# --- Correo (en local Docker usa Mailpit: http://localhost:8026) ----
MAIL_FROM=no-reply@localhost
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASSWORD=

# --- Almacenamiento de imagenes ------------------------------------
# local | supabase
STORAGE_PROVIDER=local
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=

# --- Google OAuth (opcional) ---------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
